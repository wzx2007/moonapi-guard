///|
test "type omission reviewed" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"minimum\":2}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"minimum\":2}}}}}}}}",
  )
  assert_eq(r.status, "incomplete")
  assert_true(r.findings.any(f => f.rule == "IMPLICIT_TYPE"))
}

///|
test "malformed security is not anonymous" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}},\"security\":{\"bearer\":[]}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "malformed security scopes" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}},\"security\":[{\"bearer\":\"write\"}]}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "exclusive bound requires bound" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"number\"}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"number\",\"exclusiveMinimum\":true}}}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "constraint type mismatch reviewed" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\",\"minimum\":2}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\",\"minimum\":2}}}}}}}}",
  )
  assert_eq(r.status, "incomplete")
  assert_true(r.findings.any(f => f.rule == "CONSTRAINT_TYPE"))
}

///|
test "response media removal is reviewed" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\"}},\"text/plain\":{\"schema\":{\"type\":\"string\"}}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\"}}}}}}}}}",
  )
  assert_eq(r.status, "incomplete")
  assert_true(r.findings.any(f => f.rule == "RESPONSE_MEDIA_REMOVED"))
}

///|
test "unchanged auth is compatible" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}},\"security\":[{\"a\":[]}],\"components\":{\"securitySchemes\":{\"a\":{\"type\":\"http\",\"scheme\":\"bearer\"},\"b\":{\"type\":\"apiKey\",\"in\":\"header\",\"name\":\"X-Key\"},\"oauth\":{\"type\":\"oauth2\",\"flows\":{\"clientCredentials\":{\"tokenUrl\":\"https://auth.example.test/token\",\"scopes\":{\"read\":\"Read\",\"write\":\"Write\"}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}},\"security\":[{\"a\":[]}],\"components\":{\"securitySchemes\":{\"a\":{\"type\":\"http\",\"scheme\":\"bearer\"},\"b\":{\"type\":\"apiKey\",\"in\":\"header\",\"name\":\"X-Key\"},\"oauth\":{\"type\":\"oauth2\",\"flows\":{\"clientCredentials\":{\"tokenUrl\":\"https://auth.example.test/token\",\"scopes\":{\"read\":\"Read\",\"write\":\"Write\"}}}}}}}",
  )
  assert_eq(r.status, "compatible")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

