test "invalid JSON" {
  let r = @guard.compare_text(
    "{", "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "root array invalid" {
  let r = @guard.compare_text(
    "[]", "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "OpenAPI 3.1 rejected" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.1.0\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "missing info rejected" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.0.3\",\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
