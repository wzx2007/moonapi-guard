    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\",\"pattern\":\"b\"}}}}}}}}",
  )
  assert_eq(r.status, "incomplete")
  assert_true(r.findings.any(f => f.rule == "CONSTRAINT_REVIEW"))
}

