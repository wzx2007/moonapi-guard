}

///|
test "negative length" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\"}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\",\"minLength\":-1}}}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "inverted bounds" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"number\"}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"number\",\"minimum\":5,\"maximum\":1}}}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "required entries invalid" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"required\":[2]}}}}}}}}",
