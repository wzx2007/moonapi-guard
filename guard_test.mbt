///|
test "empty responses invalid" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "duplicate parameters invalid" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"parameters\":[{\"name\":\"filter\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"name\":\"filter\",\"in\":\"query\",\"required\":false,\"schema\":{\"type\":\"string\"}}]}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "invalid schema type" {
  let r = @guard.compare_text(
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"string\"}}}}}}}}",
    "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Orders\",\"version\":\"1\"},\"paths\":{\"/orders\":{\"get\":{\"responses\":{\"200\":{\"description\":\"OK\"}},\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":[\"string\",\"null\"]}}}}}}}}",
  )
  assert_eq(r.status, "invalid")
  assert_true(r.errors.is_empty() == (r.status != "invalid"))
}

///|
test "array missing items" {
